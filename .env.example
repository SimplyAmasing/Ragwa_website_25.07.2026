# ─── Firebase (chek-chak project) ───────────────────────────────────────────
# Web config only. These are identifiers, not secrets — access is governed by
# Firestore security rules, not by hiding these values. CI injects them from
# GitHub Actions secrets (see .github/workflows/deploy-pages.yml); this file is
# the local-dev template.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=chek-chak.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=chek-chak
VITE_FIREBASE_STORAGE_BUCKET=chek-chak.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=721392320778
VITE_FIREBASE_APP_ID=

# ─── Storefront ─────────────────────────────────────────────────────────────
# The shop this site serves — Firestore shops/{id}. Everything shown is scoped
# to this id via item_shop_links.shop_id.
VITE_SHOP_ID=f25fb6a4a30d4018abae

# Base URL of the deployed chekchak-worker. The site reads the catalog and
# writes orders through its /storefront/* routes because the Firestore rules
# block anonymous access. e.g. https://chekchak-worker.<account>.workers.dev
VITE_WORKER_URL=

# Cloudflare R2 public base URL for item images. An item's image_key is a key
# without extension (e.g. "items/abc123"); the reader appends "/card.webp" etc.
# Items whose image is stored as a full URL (image_web / image_mobile) ignore
# this. Leave blank to fall back to placeholders.
VITE_R2_PUBLIC_URL=

# Default UI language until the visitor picks one: he | ar | en
VITE_DEFAULT_LOCALE=he
